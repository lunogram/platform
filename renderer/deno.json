{
  "tasks": {
    "start": "deno run --allow-net=nats:4222 --allow-env=NATS_URL,TEMPLATICAL_SOCIAL_ICONS_BASE_URL,TMPDIR,TMP,TEMP --allow-sys=homedir --allow-read=. main.ts",
    "dev": "deno run --watch --allow-net --allow-env --allow-sys --allow-read main.ts",
    "test": "deno test --allow-net --allow-env=NATS_URL,TEMPLATICAL_SOCIAL_ICONS_BASE_URL,TMPDIR,TMP,TEMP --allow-sys=homedir --allow-read=. --no-check"
  },
  "imports": {
    "@nats-io/nats-core": "jsr:@nats-io/nats-core@^3",
    "@nats-io/transport-deno": "jsr:@nats-io/transport-deno@^3",
    "react": "npm:react@^18.3.1",
    "react/jsx-runtime": "npm:react@^18.3.1/jsx-runtime",
    "react-dom/server": "npm:react-dom@^18.3.1/server",
    "@react-email/components": "npm:@react-email/components@^0.0.31",
    "@react-email/render": "npm:@react-email/render@^1.0.5",
    "sucrase": "npm:sucrase@^3.35.0",
    "@std/assert": "jsr:@std/assert@^1",
    "@templatical/renderer": "npm:@templatical/renderer@0.19.0",
    "@templatical/types": "npm:@templatical/types@0.19.0",
    "mjml": "npm:mjml@^5.4.0",
    "html-to-text": "npm:html-to-text@^9.0.5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
