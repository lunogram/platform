{
  "name": "lunogram",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "pnpm --filter \"@lunogram/*\" --stream start",
    "build": "pnpm --filter \"@lunogram/*\" build",
    "lint": "pnpm --filter \"@lunogram/*\" lint",
    "test": "pnpm --filter \"@lunogram/*\" --stream test",
    "docker:build": "pnpm --filter \"@lunogram/*\" docker:build",
    "docker:build:push": "pnpm --filter \"@lunogram/*\" docker:build:push",
    "analyze:ui:bundle": "pnpm build && npx source-map-explorer './apps/ui/build/static/js/*.js'"
  }
}